DATABASE_URL="postgresql://usuario-exemplo:senha-exemplo@localhost:5432/banco-exemplo?schema=public"
APP_URL="http://127.0.0.1:3000"
# Absolute directory outside public/; defaults to .local-media in the project.
PHOTO_STORAGE_DIR=

# Homologação: diretório privado dedicado no disco persistente.
NOIVARA_HOMOLOG_RATE_LIMIT_DIR=
# Required by Docker Compose for a new, dedicated local database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional restricted demonstration mode. Leave all six variables below unset for normal operation.
# Render production fails closed when the mode is absent or incomplete.
# In production APP_URL must be the exact HTTPS origin, and HTTPS must be enforced at the ingress.
# In demonstration mode PHOTO_STORAGE_DIR must be an explicit absolute private path, backed by a verified persistent volume.
# Each Basic username must be secret and generated from 16 random bytes as 32 lowercase hexadecimal characters.
# Configure values only in the hosting provider; never commit credentials.
# NOIVARA_HOMOLOGACAO=1
# NOIVARA_HOMOLOG_USUARIO=
# NOIVARA_HOMOLOG_SENHA=
# NOIVARA_HOMOLOG_USUARIO_2=
# NOIVARA_HOMOLOG_SENHA_2=
# NOIVARA_HOMOLOG_CONTA_ID=
